rules_version = '2';
// NcedoCare shared Firestore rules — MUST match NcedoCare-web/firestore.rules
// Source of truth: NcedoCare/firestore.rules (run scripts/sync-firestore-rules.ps1 after edits)
service cloud.firestore {
  match /databases/{database}/documents {

    function staffExists() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function isStaff() {
      return staffExists();
    }

    function isAdmin() {
      return isStaff() && staffDoc().role == 'admin';
    }

    function sameFacility(facilityId) {
      return isStaff() && staffDoc().facilityId == facilityId;
    }

    function inviteEmailMatches() {
      return request.auth != null &&
        request.auth.token.email != null &&
        resource.data.email == request.auth.token.email;
    }

    // Web staff portal — login + profile
    match /staff/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && isAdmin() &&
        resource.data.facilityId == staffDoc().facilityId;
    }

    // Web admin staff lists (path-scoped queries)
    match /facilities/{facilityId}/staff/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if request.auth != null && sameFacility(facilityId);
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && isAdmin() && sameFacility(facilityId);
    }

    match /staffInvites/{inviteId} {
      allow create: if isAdmin() &&
        staffDoc().facilityId == request.resource.data.facilityId;
      allow get, list: if request.auth != null && (
        inviteEmailMatches() ||
        (isAdmin() && sameFacility(resource.data.facilityId))
      );
      allow update: if request.auth != null && (
        (inviteEmailMatches() && request.resource.data.status == 'accepted') ||
        (isAdmin() && sameFacility(resource.data.facilityId))
      );
    }

    // Mobile patients may create; only admins may update existing records
    match /facilities/{facilityId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && isAdmin() && sameFacility(facilityId);
    }

    // Mobile patient profiles — patient owns record; same-facility staff may read for clinical care
    match /patients/{patientId} {
      allow read, write: if request.auth != null && request.auth.uid == patientId;
      allow read: if request.auth != null && isStaff() && (
        sameFacility(resource.data.facilityId) ||
        sameFacility(resource.data.primaryFacilityId)
      );
      allow write: if sameFacility(resource.data.facilityId);
      allow create: if sameFacility(request.resource.data.facilityId);
    }

    match /triageCases/{caseId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (
        resource.data.patientId == request.auth.uid ||
        sameFacility(resource.data.facilityId)
      );
    }

    match /facilityQueues/{facilityId}/activeQueue/{caseId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /blockchainEvents/{eventId} {
      allow read: if request.auth != null && isStaff() &&
        staffDoc().role in ['doctor', 'admin'];
      allow write: if false;
    }
  }
}
