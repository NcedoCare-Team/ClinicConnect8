rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function patientDoc() {
      return get(/databases/$(database)/documents/patients/$(request.auth.uid)).data;
    }

    function sameFacility(facilityId) {
      return request.auth != null && staffDoc().facilityId == facilityId;
    }

    match /staff/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null &&
        (request.auth.uid == uid || sameFacility(resource.data.facilityId));
      allow update: if request.auth != null &&
        sameFacility(resource.data.facilityId) &&
        staffDoc().role == 'admin';
    }

    match /facilities/{facilityId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if sameFacility(facilityId) && staffDoc().role == 'admin';
    }

    match /patients/{patientId} {
      // Patients can read/write only their own profile
      allow read, write: if request.auth != null && request.auth.uid == patientId;

      // Staff at the same facility can read/write patient records
      allow read, write: if sameFacility(resource.data.facilityId);
      allow create: if sameFacility(request.resource.data.facilityId);
    }

    match /triageCases/{caseId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (
        resource.data.patientId == request.auth.uid ||
        patientDoc().role in ['nurse', 'doctor', 'admin']
      );
    }

    match /facilityQueues/{facilityId}/activeQueue/{caseId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /blockchainEvents/{eventId} {
      allow read: if request.auth != null &&
        patientDoc().role in ['doctor', 'admin'];
      allow write: if false;
    }
  }
}
