{
  "expo": {
    "name": "NcedoCare",
    "slug": "ncedocare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false, 
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "NcedoCare needs camera access to support your healthcare session.",
          "microphonePermission": "NcedoCare needs microphone access to capture voice input.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "NcedoCare needs microphone access to capture voice input."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NcedoCare needs photo library access so you can upload documents or reports."
        }
      ]
    ]
  }
}